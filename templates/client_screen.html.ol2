    <!-- client_screen.html (Combat Dialog Addition) -->
    <dialog id="combat-action-dialog" style="border: 2px solid #ffcc00; background: #222; color: #fff; padding: 20px; font-family: monospace; border-radius: 6px; width: 450px;">
        <h3 style="color: #ffcc00; margin-top: 0; border-bottom: 1px solid #444; padding-bottom: 8px;">Targeting Resolution Matrix</h3>
    
        <!-- Section 1: Crew Telemetry Counters -->
        <div id="dialog-crew-telemetry" style="background: #111; padding: 8px; margin-bottom: 15px; border-radius: 4px; font-size: 12px;">
            <div>Total Operational Crew: <span id="lbl-total-crew" style="font-weight: bold; color: #00ff00;">0</span></div>
            <div>Crew Actions Remaining This Turn: <span id="lbl-crew-remaining" style="font-weight: bold; color: #ffcc00;">0</span></div>
        </div>

        <!-- Section 2: Interactive Selectors -->
        <form method="dialog">
            <div style="margin-bottom: 12px;">
                <label style="display: block; margin-bottom: 4px; font-size: 12px; color: #aaa;">Select Firing System / Weapon:</label>
                <select id="sel-combat-weapon" style="width: 100%; background: #333; color: #fff; border: 1px solid #555; padding: 6px; font-family: monospace;" onchange="updateLiveToHitOdds()">
                    <!-- Populated dynamically via JS arrays -->
                </select>
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 4px; font-size: 12px; color: #aaa;">Select Defending Target:</label>
                <select id="sel-combat-target" style="width: 100%; background: #333; color: #fff; border: 1px solid #555; padding: 6px; font-family: monospace;" onchange="updateLiveToHitOdds()">
                    <!-- Populated dynamically via JS arrays -->
                </select>
            </div>

            <!-- Section 3: Live Probability Display -->
            <div style="background: #1a1a1a; border: 1px solid #333; padding: 10px; text-align: center; margin-bottom: 20px; border-radius: 4px;">
                <div style="font-size: 11px; color: #888; text-transform: uppercase;">To-Hit Threshold Probability</div>
                <div id="lbl-live-to-hit" style="font-size: 28px; font-weight: bold; color: #00ff00; margin: 5px 0;">--</div>
                <div id="lbl-combat-notes" style="font-size: 11px; color: #ff3333;">Select parameters to run matrix calculation.</div>
            </div>

            <!-- Section 4: Action Triggers -->
            <div style="display: flex; justify-content: space-between;">
                <button type="button" onclick="closeCombatDialog()" style="background: #444; color: #fff; border: none; padding: 8px 16px; cursor: pointer; font-family: monospace;">Cancel</button>
                <button type="button" id="btn-fire-weapon" onclick="commitFireActionAttack()" style="background: #ffcc00; color: #000; border: none; padding: 8px 16px; font-weight: bold; cursor: pointer; font-family: monospace;">ENGAGE TARGET</button>
            </div>
        </form>
    </dialog>

    <script>
        // ── Movement State ────────────────────────────────────────────────
        let currentGameId      = null;   // game the player is currently in
        let currentMoveFile    = null;   // filename of the active phase file
        let movementQueue      = null;   // the full queue object
        let myMoveState        = {
            isMyTurn:      false,
            maneuvered:    false,
            halfRemaining: 0,
            fullRemaining: 0,
            halfForced:    false
        };
        let turnPollTimer      = null;
        let TURN_POLL_MS       = 10000;  // check every 10 seconds during rejoin

        // ── Session Management ────────────────────────────────────────────
        let currentUser = null;
        // Run immediately when the script loads
        document.addEventListener("DOMContentLoaded", () => {
            const savedToken = localStorage.getItem("cwo_session_token");
            const savedUser  = localStorage.getItem("cwo_username");

            if (savedToken && savedUser) {
                // Attempt to auto-authenticate using the token
                verifyAutoLogin(savedUser, savedToken);
            } else {
                // Show your normal login panel overlay here if they aren't logged in
                console.log("No saved session found. Prompting for login.");
            }
        });

        async function verifyAutoLogin(username, token) {
            try {
                const response = await fetch('/api/auto_login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, token })
                });

                if (response.ok) {
                    currentUser = username; // Set your global user variable
                    document.getElementById('topBarUsername').textContent = username;
                    console.log("Auto-login successful!");
                } else {
                    // Token expired or invalid, clear it out
                    handleExplicitLogout();
                }
            } catch (err) {
                console.error("Network error during auto-login:", err);
            }
        }

        async function loadSessionUser() {
            try {
                const response = await fetch('/get_session_user');
                if (response.ok) {
                    const data = await response.json();
                    currentUser = data.username;
                    document.getElementById('topBarUsername').textContent = currentUser;
                    if (data.is_admin) {
                        document.getElementById('ID_DATABASE').classList.add('visible');
                    }
                } else {
                    window.location.href = '/login';
                }
            } catch (err) {
                console.error('Error fetching session user:', err);
                window.location.href = '/login';
            }
        }

        function clickLogout() {
            handleExplicitLogout();
        }

        function handleExplicitLogout() {
            localStorage.removeItem("cwo_session_token");
            localStorage.removeItem("cwo_username");
            // Redirect them back to your login screen panel view
            location.reload(); 
        }

        function clickDatabase() { window.location.href = '/admin';  }

        loadSessionUser();

        // ── Map Canvas Engine ─────────────────────────────────────────────
        const mapState = {
            image: null, filename: null,
            zoom: 1.0, panX: 0, panY: 0,
            isPanning: false, lastMouseX: 0, lastMouseY: 0,
        };

        const canvas  = document.getElementById('mapCanvas');
        const ctx     = canvas.getContext('2d');
        const wrapper = document.getElementById('mapCanvasWrapper');

        function resizeCanvas() {
            canvas.width  = wrapper.clientWidth;
            canvas.height = wrapper.clientHeight;
            drawMap();
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function drawMap() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            if (!mapState.image) return;
            ctx.save();
            ctx.translate(mapState.panX, mapState.panY);
            ctx.scale(mapState.zoom, mapState.zoom);
            ctx.drawImage(mapState.image, 0, 0);
            ctx.restore();
        }

        function showMapPreview(filename, forceReload = false, gameId = null) {
            if (!filename) { clearMap(); return; }
            if (filename === mapState.filename && mapState.image && !forceReload) return;
        
            const statusBar   = document.getElementById('mapStatusBar');
            const placeholder = document.getElementById('mapPlaceholder');
            statusBar.textContent = `Rendering: ${filename}`;
            statusBar.classList.remove('hidden');
            placeholder.style.display = 'none';
            mapState.filename = filename;
            mapState.image    = null;
            mapState.gameId   = gameId;   // ← track which context this preview belongs to
        
            const img = new Image();
            img.onload = () => {
                mapState.image = img;
                statusBar.classList.add('hidden');
                fitMapToCanvas();
            };
            img.onerror = () => {
                statusBar.textContent = `Failed to render: ${filename}`;
            };
        
            // ── Pick the correct endpoint based on context ──
            const baseUrl = gameId
                ? `/render_game_file/${encodeURIComponent(gameId)}/${encodeURIComponent(filename)}`
                : `/render_map/${encodeURIComponent(filename)}`;
        
            const url = forceReload ? `${baseUrl}?t=${Date.now()}` : baseUrl;
        
            img.src = url;
        }

        function clearMap() {
            mapState.image = null; mapState.filename = null; mapState.gameId = null;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            document.getElementById('mapStatusBar').classList.add('hidden');
            document.getElementById('mapPlaceholder').style.display = 'block';
            stopPolling();
        }
        
        function fitMapToCanvas() {
            if (!mapState.image) return;
            const scaleX  = canvas.width  / mapState.image.width;
            const scaleY  = canvas.height / mapState.image.height;
            mapState.zoom = Math.min(scaleX, scaleY, 1.0);
            mapState.panX = (canvas.width  - mapState.image.width  * mapState.zoom) / 2;
            mapState.panY = (canvas.height - mapState.image.height * mapState.zoom) / 2;
            updateZoomLabel();
            drawMap();
        }

        // ── Zoom ──────────────────────────────────────────────────────────
        const ZOOM_STEP = 0.15, ZOOM_MIN = 0.05, ZOOM_MAX = 8.0;

        function zoomIn()    { applyZoom(mapState.zoom + ZOOM_STEP); }
        function zoomOut()   { applyZoom(mapState.zoom - ZOOM_STEP); }
        function zoomReset() { fitMapToCanvas(); }

        function applyZoom(newZoom, originX, originY) {
            if (!mapState.image) return;
            newZoom       = Math.min(Math.max(newZoom, ZOOM_MIN), ZOOM_MAX);
            const ox      = originX ?? canvas.width  / 2;
            const oy      = originY ?? canvas.height / 2;
            const ratio   = newZoom / mapState.zoom;
            mapState.panX = ox - ratio * (ox - mapState.panX);
            mapState.panY = oy - ratio * (oy - mapState.panY);
            mapState.zoom = newZoom;
            updateZoomLabel();
            drawMap();
        }

        function updateZoomLabel() {
            document.getElementById('zoomLabel').textContent =
                Math.round(mapState.zoom * 100) + '%';
        }

        wrapper.addEventListener('wheel', (e) => {
            e.preventDefault();
            const rect  = wrapper.getBoundingClientRect();
            const delta = e.deltaY < 0 ? ZOOM_STEP : -ZOOM_STEP;
            applyZoom(mapState.zoom + delta, e.clientX - rect.left, e.clientY - rect.top);
        }, { passive: false });

        wrapper.addEventListener('mousedown', (e) => {
            if (e.button !== 0) return;
            mapState.isPanning = true;
            mapState.lastMouseX = e.clientX; mapState.lastMouseY = e.clientY;
            wrapper.classList.add('panning');
        });

        window.addEventListener('mousemove', (e) => {
            if (!mapState.isPanning) return;
            mapState.panX += e.clientX - mapState.lastMouseX;
            mapState.panY += e.clientY - mapState.lastMouseY;
            mapState.lastMouseX = e.clientX; mapState.lastMouseY = e.clientY;
            drawMap();
        });

        window.addEventListener('mouseup', () => {
            mapState.isPanning = false;
            wrapper.classList.remove('panning');
        });

        // ── Right-Click Car Targeting ─────────────────────────────────────
        // Cars are rendered as pixels inside the server-generated map image
        // (not individual DOM elements), so "clicking a car" is done via
        // coordinate hit-testing: undo the current pan/zoom to get world
        // (map-image-pixel) coordinates, then compare against known car
        // positions from live game state.

        // ASSUMPTION: matches the GAME_LENGTH_PX=40 scale used throughout
        // the Python modules (los_distance.py etc.) -- confirm this matches
        // how /render_game_file actually rasterizes car positions.
        const GAME_LENGTH_PX = 40;

        // From your own Upload Car Image modal: "BMP, 21x41 pixels" -- used
        // as the clickable hit-box size around each car's center, in
        // un-zoomed map-image pixels (screenToWorld() already undoes zoom).
        const CAR_HIT_HALF_WIDTH_PX = 21 / 2;
        const CAR_HIT_HALF_HEIGHT_PX = 41 / 2;

        function screenToWorld(clientX, clientY) {
            const rect = canvas.getBoundingClientRect();
            const screenX = clientX - rect.left;
            const screenY = clientY - rect.top;
            return {
                x: (screenX - mapState.panX) / mapState.zoom,
                y: (screenY - mapState.panY) / mapState.zoom,
            };
        }

        function findCarAtWorldPoint(worldX, worldY, cars) {
            for (const car of cars) {
                // ASSUMPTION (needs confirming): field names for car
                // position within /api/game_state/<gameId>'s car list.
                // Matches the CarPosition schema (local_starting_x_qty /
                // local_starting_y_qty, in game lengths/inches) used
                // elsewhere. If your actual field names differ, this
                // hit-test will silently never match -- update these two
                // lines to whatever /api/game_state really returns.
                if (car.local_starting_x_qty === undefined || car.local_starting_y_qty === undefined) {
                    continue;
                }
                const carPxX = car.local_starting_x_qty * GAME_LENGTH_PX;
                const carPxY = car.local_starting_y_qty * GAME_LENGTH_PX;

                if (
                    Math.abs(worldX - carPxX) <= CAR_HIT_HALF_WIDTH_PX &&
                    Math.abs(worldY - carPxY) <= CAR_HIT_HALF_HEIGHT_PX
                ) {
                    return car;
                }
            }
            return null;
        }

        canvas.addEventListener('contextmenu', async (event) => {
            event.preventDefault();
            if (!navState.gameId) return;

            const { x: worldX, y: worldY } = screenToWorld(event.clientX, event.clientY);

            let cars;
            try {
                const res = await fetch(`/api/game_state/${navState.gameId}`);
                const data = await res.json();
                if (!data.success || !data.cars) return;
                cars = data.cars;
            } catch (err) {
                console.error('Failed to fetch game state for right-click hit-test:', err);
                return;
            }

            const hitCar = findCarAtWorldPoint(worldX, worldY, cars);
            if (!hitCar) return;                       // right-clicked empty space -- ignore
            if (hitCar.owner === currentUser) return;   // can't target your own car

            openCombatActionDialog(hitCar.owner, event.clientX, event.clientY);
        });

        function positionDialogNear(dialog, clientX, clientY) {
            // The dialog's CSS sets width:450px; no fixed height, so this is
            // an estimate for keeping it on-screen -- adjust if your actual
            // rendered height differs noticeably.
            const approxWidth = 450;
            const approxHeight = 340;

            let left = clientX + 12;
            let top = clientY + 12;
            if (left + approxWidth > window.innerWidth) left = window.innerWidth - approxWidth - 12;
            if (top + approxHeight > window.innerHeight) top = window.innerHeight - approxHeight - 12;

            dialog.style.position = 'fixed';
            dialog.style.margin = '0';
            dialog.style.left = Math.max(12, left) + 'px';
            dialog.style.top = Math.max(12, top) + 'px';
        }

        let lastTouchDist = null;

        wrapper.addEventListener('touchstart', (e) => {
            if (e.touches.length === 1) {
                mapState.isPanning  = true;
                mapState.lastMouseX = e.touches[0].clientX;
                mapState.lastMouseY = e.touches[0].clientY;
            }
            if (e.touches.length === 2) lastTouchDist = getTouchDist(e.touches);
        }, { passive: true });

        wrapper.addEventListener('touchmove', (e) => {
            if (e.touches.length === 1 && mapState.isPanning) {
                mapState.panX += e.touches[0].clientX - mapState.lastMouseX;
                mapState.panY += e.touches[0].clientY - mapState.lastMouseY;
                mapState.lastMouseX = e.touches[0].clientX;
                mapState.lastMouseY = e.touches[0].clientY;
                drawMap();
            }
            if (e.touches.length === 2 && lastTouchDist) {
                const dist  = getTouchDist(e.touches);
                const ratio = dist / lastTouchDist;
                const cx    = (e.touches[0].clientX + e.touches[1].clientX) / 2;
                const cy    = (e.touches[0].clientY + e.touches[1].clientY) / 2;
                const rect  = wrapper.getBoundingClientRect();
                applyZoom(mapState.zoom * ratio, cx - rect.left, cy - rect.top);
                lastTouchDist = dist;
            }
        }, { passive: true });

        wrapper.addEventListener('touchend', () => {
            mapState.isPanning = false; lastTouchDist = null;
        });

        function getTouchDist(touches) {
            const dx = touches[0].clientX - touches[1].clientX;
            const dy = touches[0].clientY - touches[1].clientY;
            return Math.sqrt(dx * dx + dy * dy);
        }

        // ── Game File Navigation ──────────────────────────────────────────
        const PHASE_ORDER = ['0','1M','1C','2M','2C','3M','3C','4M','4C','5M','5C','EOT'];

        const navState = { gameId: null, files: [], currentIndex: -1 };

        function parseGameFilename(filename) {
            const match = filename.match(/T(\d+)P(0|1M|1C|2M|2C|3M|3C|4M|4C|5M|5C|EOT)\.txt$/i);
            if (!match) return null;
            return { filename, turn: parseInt(match[1]), phase: match[2].toUpperCase() };
        }

        function sortGameFiles(filenames) {
            const parsed = filenames.map(parseGameFilename).filter(f => f !== null);
            parsed.sort((a, b) => {
                if (a.turn !== b.turn) return a.turn - b.turn;
                return PHASE_ORDER.indexOf(a.phase) - PHASE_ORDER.indexOf(b.phase);
            });
            return parsed.map(f => f.filename);
        }

        function updateMovementButtons() {
            const movementPhases = ['1M', '2M', '3M', '4M', '5M'];
            let   enabled        = false;

            if (navState.files.length > 0 &&
                navState.currentIndex === navState.files.length - 1) {

                const filename = navState.files[navState.currentIndex];
                const parsed   = parseGameFilename(filename);
                if (parsed && movementPhases.includes(parsed.phase)) {
                    enabled = true;
                }
            }

            const movementBtnIds = [
                'ID_D6L', 'ID_D5L', 'ID_D4L', 'ID_D3L', 'ID_D2L', 'ID_D1L',
                'ID_STR',
                'ID_D1R', 'ID_D2R', 'ID_D3R', 'ID_D4R', 'ID_D5R', 'ID_D6R'
            ];

            movementBtnIds.forEach(id => {
                document.getElementById(id).disabled = !enabled;
            });

            // Firing Action stays disabled during movement phases —
            // it activates during combat phases (handled separately later)
            document.getElementById('ID_FIRE').disabled = true;
        }

        async function loadGameFileList(gameId) {
            navState.gameId = gameId; navState.files = []; navState.currentIndex = -1;
            try {
                const response = await fetch(`/list_game_files/${gameId}`);
                if (response.ok) {
                    const data = await response.json();
                    navState.files        = sortGameFiles(data.files || []);
                    navState.currentIndex = navState.files.length - 1;
                }
            } catch (err) {
                console.error('Error loading game file list:', err);
            }
            updateNavButtons();
            updateMovementButtons();   // ← ensure buttons start disabled
            showCurrentGameFile(true);
        }
        
        function showCurrentGameFile(forceReload = false) {
            if (navState.currentIndex < 0 || navState.files.length === 0) {
                document.getElementById('navFileLabel').textContent = '';
                stopPolling();
                return;
            }
            const filename = navState.files[navState.currentIndex];
            showMapPreview(filename, forceReload, navState.gameId);
        
            // Nav label is now driven by live polling data (see startPolling), not the filename —
            // the filename's phase suffix doesn't reflect subphase transitions within the same file.
        
            startPolling(filename, navState.gameId);
        }

        function formatPhaseLabel(turn, phase) {
            if (phase === '0')   return `Turn ${turn}, Start`;
            if (phase === 'EOT') return `Turn ${turn}, End of Turn`;
            return `Turn ${turn}, Phase ${phase[0]} (${phase.endsWith('M') ? 'Movement' : 'Combat'})`;
        }

        function navGameFile(direction) {
            if (navState.files.length === 0) return;
            switch (direction) {
                case 'first': navState.currentIndex = 0; break;
                case 'last':  navState.currentIndex = navState.files.length - 1; break;
                case 'prev':  if (navState.currentIndex > 0) navState.currentIndex--; break;
                case 'next':  if (navState.currentIndex < navState.files.length - 1) navState.currentIndex++; break;
            }
            updateNavButtons();
            showCurrentGameFile();
        }

        function updateNavButtons() {
            const atFirst = navState.currentIndex <= 0;
            const atLast  = navState.currentIndex >= navState.files.length - 1;
            const noFiles = navState.files.length === 0;

            document.getElementById('ID_NAV_FIRST').disabled = noFiles || atFirst;
            document.getElementById('ID_NAV_PREV').disabled  = noFiles || atFirst;
            document.getElementById('ID_NAV_NEXT').disabled  = noFiles || atLast;
            document.getElementById('ID_NAV_LAST').disabled  = noFiles || atLast;

            // Enable movement buttons only when viewing the most recent file
            // AND that file is a movement phase (P1M through P5M)
            updateMovementButtons();
        }

        updateNavButtons();

        // ── Create Game Dialog ────────────────────────────────────────────
        function clickCreateGame() {
            populateMapDropdown();
            document.getElementById('gameName').value          = '';
            document.getElementById('numPlayers').value        = 2;
            document.getElementById('divisionSlider').value    = 5000;
            document.getElementById('autoStartToggle').checked = false;
            updateDivisionDisplay(5000);
            document.getElementById('createGameModal').classList.add('active');
        }

        function closeCreateGameDialog() {
            document.getElementById('createGameModal').classList.remove('active');
        }

        function updateDivisionDisplay(value) {
            const f = Number(value).toLocaleString();
            document.getElementById('divisionDisplay').textContent = f;
            document.getElementById('divisionValue').textContent   = f;
        }

        async function populateMapDropdown() {
            const select = document.getElementById('mapSelect');
            select.innerHTML = '<option value="">-- Loading maps... --</option>';
            try {
                const response = await fetch('/list_maps');
                if (response.ok) {
                    const maps = await response.json();
                    select.innerHTML = maps.length === 0
                        ? '<option value="">-- No maps uploaded yet --</option>'
                        : '<option value="">-- Select a map --</option>' +
                        maps.map(m => `<option value="${m}">${m}</option>`).join('');
                } else {
                    select.innerHTML = '<option value="">-- Failed to load maps --</option>';
                }
            } catch (err) {
                select.innerHTML = '<option value="">-- Error loading maps --</option>';
            }

            // ── UPDATED: Handle map profile scanning on dropdown change ──
            select.onchange = async () => {
                const filename = select.value;
                showMapPreview(filename, true);
        
                if (!filename) return;
        
                try {
                    // Fetch parsed player maximum limits from the map file profile
                    const res = await fetch(`/get_map_max_players/${encodeURIComponent(filename)}`);
                    if (res.ok) {
                        const data = await res.json();
                        const playerInput = document.getElementById('numPlayers');
                
                        // Dynamically update the input bounds and set the default value
                        playerInput.max = data.max_players;
                        playerInput.value = data.default_players;
                    }
                } catch (err) {
                    console.error("Failed to parse map player limits:", err);
                }
            };
        }

        async function confirmCreateGame() {
            const gameName  = document.getElementById('gameName').value.trim();
            const map       = document.getElementById('mapSelect').value;
            const players   = parseInt(document.getElementById('numPlayers').value);
            const division  = parseInt(document.getElementById('divisionSlider').value);
            const autoStart = document.getElementById('autoStartToggle').checked;

            if (!gameName)   { alert('Please enter a game name.');        return; }
            if (!map)        { alert('Please select a map.');              return; }
            if (players < 2) { alert('At least 2 players are required.'); return; }

            try {
                const response = await fetch('/create_game', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: gameName, map, max_players: players,
                        division, username: currentUser, auto_start: autoStart
                    })
                });
                if (response.ok) {
                    const result = await response.json();
                    closeCreateGameDialog();
                    alert(`Game "${gameName}" created!${autoStart ? '\nAuto-start is ON.' : ''}`);
                    // Show the map immediately after game creation
                    if (result.id) loadGameFileList(result.id);
                } else {
                    // ── CHANGED: Read the server response to get the specific reason ──
                    const err = await response.json();
                    // This will now show your custom "A game named 'Game 1' already exists" message
                    alert(`Failed to create game: ${err.error}`); 
                }
            } catch (err) {
                alert('A network error occurred. Please try again.');
            }
        }

        document.getElementById('createGameModal').addEventListener('click', function(e) {
            if (e.target === this) closeCreateGameDialog();
        });

        // ── Join Game Dialog ──────────────────────────────────────────────
        let currentJoinGameDivision = null;

        function clickJoinGame() {
            populateJoinGameDropdown();
            populateDesignDropdown();
            populateCarImageDropdown();
            document.getElementById('joinGameSelect').value              = '';
            document.getElementById('joinDesignSelect').value            = '';
            document.getElementById('joinCarImageSelect').value          = '';
            document.getElementById('gameDetails').style.display         = 'none';
            document.getElementById('designValidationMsg').style.display = 'none';
            document.getElementById('carImageJoinPreview').style.display = 'none';
            currentJoinGameDivision = null;
            document.getElementById('joinGameModal').classList.add('active');
        }

        function closeJoinGameDialog() {
            document.getElementById('joinGameModal').classList.remove('active');
        }

        async function populateJoinGameDropdown() {
            const select = document.getElementById('joinGameSelect');
            select.innerHTML = '<option value="">-- Loading games... --</option>';
            try {
                const response = await fetch('/list_games');
                if (response.ok) {
                    const games     = await response.json();
                    const openGames = games.filter(g => g.status === 'waiting');

                    select.innerHTML = openGames.length === 0
                        ? '<option value="">-- No open games available --</option>'
                        : '<option value="">-- Select a game --</option>' +
                        openGames.map(g =>
                            `<option value="${g.id}"
                                data-map="${g.map}"
                                data-players="${g.max_players}"
                                data-division="${g.division}"
                                data-createdby="${g.created_by}"
                                data-initialspeed="${g.max_initial_speed || 60}">
                                ${g.name}
                            </option>`
                        ).join('');
                } else {
                    select.innerHTML = '<option value="">-- Failed to load games --</option>';
                }
            } catch (err) {
                select.innerHTML = '<option value="">-- Error loading games --</option>';
            }
        }

        async function populateDesignDropdown() {
            const select = document.getElementById('joinDesignSelect');
            select.innerHTML = '<option value="">-- Loading designs... --</option>';
            try {
                const response = await fetch('/list_designs');
                if (response.ok) {
                    const designs = await response.json();
                    select.innerHTML = designs.length === 0
                        ? '<option value="">-- No designs available --</option>'
                        : '<option value="">-- Select a design --</option>' +
                          designs.map(d => `<option value="${d}">${d}</option>`).join('');
                } else {
                    select.innerHTML = '<option value="">-- Failed to load designs --</option>';
                }
            } catch (err) {
                select.innerHTML = '<option value="">-- Error loading designs --</option>';
            }
        }

        async function populateCarImageDropdown() {
            const select = document.getElementById('joinCarImageSelect');
            select.innerHTML = '<option value="">-- Loading car images... --</option>';
            try {
                const response = await fetch('/list_car_images');
                if (response.ok) {
                    const images = await response.json();
                    select.innerHTML = images.length === 0
                        ? '<option value="">-- No car images available --</option>'
                        : '<option value="">-- Select a car image --</option>' +
                          images.map(i =>
                              `<option value="${i.name}">${i.name} (by ${i.owner})</option>`
                          ).join('');
                } else {
                    select.innerHTML = '<option value="">-- Failed to load car images --</option>';
                }
            } catch (err) {
                select.innerHTML = '<option value="">-- Error loading car images --</option>';
            }

            select.onchange = async () => {
                const name    = select.value;
                const preview = document.getElementById('carImageJoinPreview');
                const img     = document.getElementById('carImageJoinPreviewImg');
                if (!name) { preview.style.display = 'none'; return; }
                try {
                    const r = await fetch(`/get_car_image/${encodeURIComponent(name)}`);
                    if (r.ok) {
                        const data    = await r.json();
                        img.src               = `data:image/bmp;base64,${data.base64_data}`;
                        preview.style.display = 'block';
                    }
                } catch (e) {
                    preview.style.display = 'none';
                }
            };
        }

        function getDivisionFromFilename(filename) {
            const match = filename.match(/^(\d+)K_/i);
            if (!match) return null;
            return parseInt(match[1]) * 1000;
        }

        function onDesignSelected(filename) {
            const msgBox = document.getElementById('designValidationMsg');
            msgBox.style.display = 'none'; msgBox.textContent = '';
            if (!filename || !currentJoinGameDivision) return;
            const designCost = getDivisionFromFilename(filename);
            if (designCost === null) {
                msgBox.textContent   = `⚠ Could not determine the cost of "${filename}". ` +
                                       `Please confirm it is within the ` +
                                       `${currentJoinGameDivision.toLocaleString()} division.`;
                msgBox.style.display = 'block';
                return;
            }
            if (designCost > currentJoinGameDivision) {
                msgBox.textContent   = `⚠ "${filename}" costs ${designCost.toLocaleString()}, ` +
                                       `exceeding this game's division of ` +
                                       `${currentJoinGameDivision.toLocaleString()}.`;
                msgBox.style.display = 'block';
            }
        }

        function onGameSelected(gameId) {
            const details = document.getElementById('gameDetails');
            if (!gameId) {
                details.style.display = 'none';
                currentJoinGameDivision = null;
                document.getElementById('joinSpeedContainer').style.display = 'none';
                clearMap();
                return;
            }
            const select = document.getElementById('joinGameSelect');
            const option = select.options[select.selectedIndex];
            document.getElementById('detailMap').textContent = option.dataset.map;
            document.getElementById('detailPlayers').textContent = option.dataset.players;
            document.getElementById('detailDivision').textContent = Number(option.dataset.division).toLocaleString();
            document.getElementById('detailCreatedBy').textContent = option.dataset.createdby;
            details.style.display = 'block';
            currentJoinGameDivision = parseInt(option.dataset.division);
    
            // ── NEW ACTION BLOCK: AUTOMATED ENVELOPE SCALE CONFIGURATOR ──
            const speedContainer = document.getElementById('joinSpeedContainer');
            const speedSlider = document.getElementById('joinInitialSpeed');
            const speedDisplay = document.getElementById('joinSpeedDisplay');
    
            if (speedContainer && speedSlider && speedDisplay) {
                // Pull max initial speed variable off custom data attributes passed from server loop
                const allowedMaxSpeed = option.dataset.initialspeed ? parseInt(option.dataset.initialspeed, 10) : 60;
        
                speedSlider.max = allowedMaxSpeed;
                speedSlider.value = allowedMaxSpeed; // Presumption logic: default directly to top allowed velocity metrics
                speedDisplay.textContent = allowedMaxSpeed;
                speedContainer.style.display = 'flex';
            }
            // ──────────────────────────────────────────────────────────────
    
            const designSelect = document.getElementById('joinDesignSelect');
            if (designSelect.value) onDesignSelected(designSelect.value);
            loadGameFileList(gameId);
        }

        async function confirmJoinGame() {
            const gameId       = document.getElementById('joinGameSelect').value;
            const design       = document.getElementById('joinDesignSelect').value;
            const carImageName = document.getElementById('joinCarImageSelect').value;

            if (!gameId)       { alert('Please select a game to join.'); return; }
            if (!design)       { alert('Please select a design.');        return; }
            if (!carImageName) { alert('Please select a car image.');     return; }

            if (currentJoinGameDivision) {
                const designCost = getDivisionFromFilename(design);
                if (designCost !== null && designCost > currentJoinGameDivision) {
                    alert(`Cannot join: "${design}" costs ${designCost.toLocaleString()} ` +
                          `which exceeds this game's division of ` +
                          `${currentJoinGameDivision.toLocaleString()}.`);
                    return;
                }
            }

            try {
                // Step 1 — join the game (also writes CarPosition to T1P0)
                const speedSlider = document.getElementById('joinInitialSpeed');
                const chosenStartingSpeed = speedSlider ? parseInt(speedSlider.value, 10) : 0;

                const joinResponse = await fetch('/join_game', {
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        game_id: gameId,
                        username: currentUser,
                        car_image_name: carImageName,
                        starting_speed: chosenStartingSpeed // <-- Dynamic velocity passed down to Python handlers
                    })
                });
                if (!joinResponse.ok) {
                    const err = await joinResponse.json();
                    alert(`Could not join game: ${err.error}`);
                    return;
                }
                const joinData = await joinResponse.json();

                // Step 2 — assign design
                const designResponse = await fetch('/set_player_design', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ game_id: gameId, username: currentUser, design })
                });
                if (!designResponse.ok) {
                    const err = await designResponse.json();
                    alert(`Joined but could not assign design: ${err.error}`);
                    return;
                }

                // Step 3 — record car image in database
                const carResponse = await fetch('/set_player_car_image', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ game_id: gameId, car_image_name: carImageName })
                });
                if (!carResponse.ok) {
                    const err = await carResponse.json();
                    alert(`Joined but could not assign car image: ${err.error}`);
                    return;
                }

                closeJoinGameDialog();
                if (joinData.auto_started) {
                    alert(`You joined — game is full and has auto-started!`);
                } else {
                    alert(`Successfully joined the game with design: ${design}`);
                }
                // Reload — T1P0 now has this player's car on it
                loadGameFileList(gameId);

            } catch (err) {
                alert('A network error occurred. Please try again.');
            }
        }

        document.getElementById('joinGameModal').addEventListener('click', function(e) {
            if (e.target === this) closeJoinGameDialog();
        });

        // ── ReJoin Game Dialog ────────────────────────────────────────────
        function clickRejoinGame() {
            populateRejoinDropdown();
            document.getElementById('rejoinGameSelect').value          = '';
            document.getElementById('rejoinGameDetails').style.display = 'none';
            document.getElementById('rejoinGameModal').classList.add('active');
        }

        function closeRejoinGameDialog() {
            document.getElementById('rejoinGameModal').classList.remove('active');
        }

        async function populateRejoinDropdown() {
            const select = document.getElementById('rejoinGameSelect');
            select.innerHTML = '<option value="">-- Loading your games... --</option>';
            try {
                const response = await fetch('/list_my_games');
                if (response.ok) {
                    const games = await response.json();
                    select.innerHTML = games.length === 0
                        ? '<option value="">-- You have not joined any games yet --</option>'
                        : '<option value="">-- Select a game --</option>' +
                          games.map(g =>
                              `<option value="${g.id}"
                                  data-map="${g.map}"
                                  data-status="${g.status}"
                                  data-players="${g.max_players}"
                                  data-division="${g.division}"
                                  data-createdby="${g.created_by}"
                                  data-design="${g.design || ''}">
                                  ${g.name} (${g.status.charAt(0).toUpperCase() + g.status.slice(1)})
                              </option>`
                          ).join('');
                } else {
                    select.innerHTML = '<option value="">-- Failed to load your games --</option>';
                }
            } catch (err) {
                select.innerHTML = '<option value="">-- Error loading games --</option>';
            }
        }

        function onRejoinGameSelected(gameId) {
            const details = document.getElementById('rejoinGameDetails');
            if (!gameId) { details.style.display = 'none'; clearMap(); return; }

            const select = document.getElementById('rejoinGameSelect');
            const option = select.options[select.selectedIndex];

            document.getElementById('rejoinDetailMap').textContent =
                option.dataset.map;
            document.getElementById('rejoinDetailStatus').textContent =
                option.dataset.status.charAt(0).toUpperCase() + option.dataset.status.slice(1);
            document.getElementById('rejoinDetailPlayers').textContent =
                option.dataset.players;
            document.getElementById('rejoinDetailDivision').textContent =
                Number(option.dataset.division).toLocaleString();
            document.getElementById('rejoinDetailCreatedBy').textContent =
                option.dataset.createdby;
            document.getElementById('rejoinDetailDesign').textContent =
                option.dataset.design || '(none assigned)';

            details.style.display = 'block';

            // Load game files immediately — renders most recent file
            loadGameFileList(gameId);
        }

        function confirmRejoinGame() {
            const gameId = document.getElementById('rejoinGameSelect').value;
            if (!gameId) { alert('Please select a game to rejoin.'); return; }
            closeRejoinGameDialog();
            // Force reload after closing in case same game was already showing
            loadGameFileList(gameId);
        }

        document.getElementById('rejoinGameModal').addEventListener('click', function(e) {
            if (e.target === this) closeRejoinGameDialog();
        });

        // ── Start Game Dialog ─────────────────────────────────────────────
        function clickStartGame() {
            populateStartGameDropdown();
            document.getElementById('startGameSelect').value          = '';
            document.getElementById('startGameDetails').style.display = 'none';
            document.getElementById('startGameModal').classList.add('active');
        }

        function closeStartGameDialog() {
            document.getElementById('startGameModal').classList.remove('active');
        }

        async function populateStartGameDropdown() {
            const select = document.getElementById('startGameSelect');
            select.innerHTML = '<option value="">-- Loading games... --</option>';
            try {
                const response = await fetch('/list_startable_games');
                if (response.ok) {
                    const games = await response.json();
                    select.innerHTML = games.length === 0
                        ? '<option value="">-- No games ready to start --</option>'
                        : '<option value="">-- Select a game --</option>' +
                          games.map(g =>
                              `<option value="${g.id}"
                                  data-map="${g.map}"
                                  data-players="${g.max_players}"
                                  data-division="${g.division}"
                                  data-createdby="${g.created_by}">
                                  ${g.name} (${g.joined_count}/${g.max_players} players)
                              </option>`
                          ).join('');
                } else {
                    select.innerHTML = '<option value="">-- Failed to load games --</option>';
                }
            } catch (err) {
                select.innerHTML = '<option value="">-- Error loading games --</option>';
            }
        }

        function onStartGameSelected(gameId) {
            const details = document.getElementById('startGameDetails');
            if (!gameId) { details.style.display = 'none'; return; }
            const select = document.getElementById('startGameSelect');
            const option = select.options[select.selectedIndex];
            document.getElementById('startDetailMap').textContent       = option.dataset.map;
            document.getElementById('startDetailPlayers').textContent   = `${option.dataset.players} / ${option.dataset.players}`;
            document.getElementById('startDetailDivision').textContent  = Number(option.dataset.division).toLocaleString();
            document.getElementById('startDetailCreatedBy').textContent = option.dataset.createdby;
            details.style.display = 'block';
            showMapPreview(option.dataset.map, true);
        }

        async function confirmStartGame() {
            const gameId = document.getElementById('startGameSelect').value;
            if (!gameId) { alert('Please select a game to start.'); return; }
            try {
                const response = await fetch('/start_game', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ game_id: gameId })
                });
                if (response.ok) {
                    const result = await response.json();
                    closeStartGameDialog();
                    alert(`${result.message}\nGame file: ${result.game_file}`);
                    loadGameFileList(gameId);
                } else {
                    const err = await response.json();
                    alert(`Could not start game: ${err.error}`);
                }
            } catch (err) {
                alert('A network error occurred. Please try again.');
            }
        }

        document.getElementById('startGameModal').addEventListener('click', function(e) {
            if (e.target === this) closeStartGameDialog();
        });

