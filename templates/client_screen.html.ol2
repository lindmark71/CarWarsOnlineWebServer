        // ── Upload Car Image Dialog ───────────────────────────────────────
        let selectedCarImageFile    = null;
        let selectedCarImageDataURL = null;

        function clickUploadCarImage() {
            selectedCarImageFile    = null;
            selectedCarImageDataURL = null;
            document.getElementById('uploadCarImageFilename').value       = '';
            document.getElementById('carImageName').value                 = '';
            document.getElementById('carImagePreviewField').style.display = 'none';
            document.getElementById('carImageExistsWarning').classList.remove('active');
            document.querySelector('input[name="carImagePrivacy"][value="public"]').checked = true;
            document.getElementById('uploadCarImageModal').classList.add('active');
        }

        function closeUploadCarImageDialog() {
            document.getElementById('uploadCarImageModal').classList.remove('active');
            selectedCarImageFile = null; selectedCarImageDataURL = null;
        }

        function browseCarImageFile() {
            const fi = document.createElement('input');
            fi.type = 'file'; fi.accept = '.bmp,.png,.gif'; fi.style.display = 'none';
            document.body.appendChild(fi);
            fi.addEventListener('change', (e) => {
                const file = e.target.files[0];
                document.body.removeChild(fi);
                if (!file) return;
                selectedCarImageFile = file;
                document.getElementById('uploadCarImageFilename').value = file.name;
                document.getElementById('carImageExistsWarning').classList.remove('active');
                const reader = new FileReader();
                reader.onload = (ev) => {
                    selectedCarImageDataURL = ev.target.result;
                    document.getElementById('carImagePreview').src = selectedCarImageDataURL;
                    document.getElementById('carImagePreviewField').style.display = 'block';
                };
                reader.readAsDataURL(file);
                const nameField = document.getElementById('carImageName');
                if (!nameField.value) nameField.value = file.name.replace(/\.[^.]+$/, '');
            }, { once: true });
            fi.click();
        }

        async function confirmUploadCarImage() {
            if (!selectedCarImageFile) { alert('Please select a car image file.'); return; }
            const imageName = document.getElementById('carImageName').value.trim();
            if (!imageName) { alert('Please enter a name for this car image.'); return; }
            const isPrivate = document.querySelector('input[name="carImagePrivacy"]:checked').value === 'private';
            const fd = new FormData();
            fd.append('file',       selectedCarImageFile);
            fd.append('image_name', imageName);
            fd.append('is_private', isPrivate.toString());
            try {
                const r = await fetch('/upload_car_image', { method: 'POST', body: fd });
                if (r.status === 409) {
                    const data = await r.json();
                    document.getElementById('carImageExistsMessage').textContent = data.error;
                    document.getElementById('carImageExistsWarning').classList.add('active');
                    return;
                }
                if (r.ok) {
                    closeUploadCarImageDialog();
                    alert(`Car image "${imageName}" uploaded successfully!`);
                } else {
                    const err = await r.json();
                    alert(`Upload failed: ${err.error}`);
                }
            } catch (err) { alert('A network error occurred. Please try again.'); }
        }

        document.getElementById('uploadCarImageModal').addEventListener('click', function(e) {
            if (e.target === this) closeUploadCarImageDialog();
        });

        // ── Auto-refresh polling ──────────────────────────────────────────
        // Polls the server every N seconds to detect when the current
        // game file has been updated by another player, then re-renders.

        const POLL_INTERVAL_MS = 5000;   // check every 5 seconds
        let   pollTimer        = null;
        let   lastKnownMtime   = null;

        // ── Master Dual-Channel Auto-Refresh Polling ───────────────────────
        function stopPolling() {
            if (pollTimer) {
                clearInterval(pollTimer);
                pollTimer = null;
                lastKnownMtime = null;
            }
        }
        
        function startPolling(filename, gameId = null) {
            stopPolling(); // Safely clear out any lingering timers
            if (!filename) return;
        
            pollTimer = setInterval(async () => {
                try {
                    // Channel 1: Query the file system for image-re-rendering triggers
                    const timestampUrl = gameId
                        ? `/game_file_timestamp/${encodeURIComponent(gameId)}/${encodeURIComponent(filename)}`
                        : `/map_file_timestamp/${encodeURIComponent(filename)}`;
        
                    const timestampResponse = await fetch(timestampUrl);
                    if (timestampResponse.ok) {
                        const tsData = await timestampResponse.json();
                        const mtime = tsData.mtime;
        
                        if (lastKnownMtime === null) {
                            lastKnownMtime = mtime;
                        } else if (mtime !== lastKnownMtime) {
                            console.log(`Arena map layout updated: ${filename} — redrawing canvas frames...`);
                            lastKnownMtime = mtime;
                            showMapPreview(filename, true, gameId);
                        }
                    }
        
                    // Channel 2: Query the Flask endpoint for live player telemetry data
                    if (navState.gameId) {
                        const stateResponse = await fetch(`/api/game_state/${navState.gameId}`);
                        if (stateResponse.ok) {
                            const gameStatePayload = await stateResponse.json();

                            if (gameStatePayload.success && gameStatePayload.ticker_data) {
                                const tk = gameStatePayload.ticker_data;
                                togglePhaseControls(tk.mode, tk.active_player);
                            
                                const formattedStatusString = `${tk.game_name}: Turn ${tk.turn}, Phase ${tk.phase}, [${tk.mode}], ${tk.active_player}'s turn.`;
                                const tickerElement = document.getElementById('live-turn-ticker');
                                if (tickerElement) {
                                    tickerElement.textContent = formattedStatusString;
                                }
                            
                                // ── NEW: keep the nav file label in sync with the live subphase too ──
                                const navLabel = document.getElementById('navFileLabel');
                                if (navLabel) {
                                    navLabel.textContent = `Turn ${tk.turn}, Phase ${tk.phase} (${tk.mode})`;
                                }
                            
                                if (tk.mode) {
                                    updateButtonAvailability(tk.mode);
                                }
                            }
                        }
                    }
                } catch (err) {
                    console.error('Unified polling telemetry pipeline exception error:', err);
                }
            }, POLL_INTERVAL_MS);
        }

        // client_screen.html (Interface Controls Synchronization Update)

        function togglePhaseControls(currentSubphase, currentActivePlayer) {
            // Safely look up the username element
            const userElement = document.getElementById('current-username') || document.getElementById('topBarUsername');
            const currentUsername = userElement ? userElement.innerText.trim() : currentUser;
            const isMyTurn = (currentActivePlayer === currentUsername);

            // Select the correct control container element IDs
            const movementButtonContainer = document.getElementById('movement-controls-panel');
            const firingActionButton = document.getElementById('ID_FIRE'); // ✅ Fixed ID from 'firing-action-btn' to true HTML id 'ID_FIRE'

            if (currentSubphase === 'Combat') {
                // --- WE ARE IN THE COMBAT SUBPHASE ---
                if (movementButtonContainer) {
                    movementButtonContainer.style.pointerEvents = 'none';
                    movementButtonContainer.style.opacity = '0.4';
                }

                if (firingActionButton) { // ✅ Added critical safety check wrapper
                    firingActionButton.disabled = !isMyTurn;
                    firingActionButton.style.opacity = isMyTurn ? '1.0' : '0.5';
                }
            } else {
                // --- WE ARE IN THE MOVEMENT SUBPHASE ---
                if (movementButtonContainer) {
                    movementButtonContainer.style.pointerEvents = isMyTurn ? 'auto' : 'none';
                    movementButtonContainer.style.opacity = isMyTurn ? '1.0' : '0.4';
                }

                if (firingActionButton) { // ✅ Added critical safety check wrapper
                    firingActionButton.disabled = true;
                    firingActionButton.style.opacity = '0.5';
                }
            }
        }

// ── Movement Management ───────────────────────────────────────────

        let pendingManeuver = null;   // maneuver chosen but not yet confirmed

        function setMovementButtonsEnabled(enabled) {
            const movementBtnIds = [
                'ID_D6L','ID_D5L','ID_D4L','ID_D3L','ID_D2L','ID_D1L',
                'ID_STR',
                'ID_D1R','ID_D2R','ID_D3R','ID_D4R','ID_D5R','ID_D6R'
            ];
            movementBtnIds.forEach(id => {
                document.getElementById(id).disabled = !enabled;
            });
        }

        function setHalfButtonEnabled(enabled) {
            document.getElementById('ID_HALF').disabled = !enabled;
        }

        function setBendButtonsEnabled(enabled) {
            const bendIds = [
                'ID_D6L','ID_D5L','ID_D4L','ID_D3L','ID_D2L','ID_D1L',
                'ID_D1R','ID_D2R','ID_D3R','ID_D4R','ID_D5R','ID_D6R'
            ];
            bendIds.forEach(id => {
                document.getElementById(id).disabled = !enabled;
            });
        }

        function showConfirmButton(show) {
            document.getElementById('ID_CONFIRM_MOVE').style.display =
                show ? 'inline-block' : 'none';
        }

        function showCheckTurnButton(show) {
            document.getElementById('ID_CHECK_TURN').style.display =
                show ? 'block' : 'none';
        }

        async function checkMyTurn(gameId) {
            if (!gameId) return;
            try {
                const response = await fetch(`/check_my_turn/${gameId}`);
                if (!response.ok) return;
                const data = await response.json();

                movementQueue   = data.queue   || null;
                currentMoveFile = data.filename || null;

                if (data.is_my_turn && data.needs_input) {
                    triggerYourTurnDialog(data);
                }

                // Update button states based on queue state
                updateMovementButtons();

            } catch (err) {
                console.error('Error checking turn:', err);
            }
        }

        function triggerYourTurnDialog(data) {
            const phase   = data.phase || '?';
            const queue   = data.queue;
            const me      = queue
                ? queue.players.find(p => p.username === currentUser)
                : null;

            let details = `Phase ${phase} Movement`;
            if (me) {
                details += `\nSpeed: ${me.speed} mph`;
                details += `\nCar lengths to move: ${me.remaining}`;
                if (me.half_remaining > 0 && !me.half_forced) {
                    details += '\n(includes a ½ car length you can use in either order)';
                }
            }

            document.getElementById('yourTurnDetails').textContent = details;
            document.getElementById('yourTurnModal').classList.add('active');
        }

        function confirmYourTurn() {
            document.getElementById('yourTurnModal').classList.remove('active');

            // Set up button state for this player's move
            if (!movementQueue) return;

            const me = movementQueue.players.find(
                p => p.username === currentUser && !p.done
            );
            if (!me) return;

            myMoveState = {
                isMyTurn:      true,
                maneuvered:    me.maneuvered,
                halfRemaining: me.half_remaining,
                fullRemaining: me.full_remaining,
                halfForced:    me.half_forced
            };

            pendingManeuver = null;

            // Enable movement buttons
            setMovementButtonsEnabled(true);

            // Enable half button only if half is available and not forced
            setHalfButtonEnabled(
                me.half_remaining > 0 && !me.half_forced
            );

            // Disable bends if already maneuvered
            if (me.maneuvered) {
                setBendButtonsEnabled(false);
            }

            showConfirmButton(false);   // not yet until maneuver chosen
        }

        function selectManeuver(maneuver) {
            if (!myMoveState.isMyTurn) return;

            pendingManeuver = maneuver;

            // If a bend was chosen, disable all other bends
            const bendManeuvers = [
                'D1L','D2L','D3L','D4L','D5L','D6L',
                'D1R','D2R','D3R','D4R','D5R','D6R'
            ];
            if (bendManeuvers.includes(maneuver)) {
                myMoveState.maneuvered = true;
                setBendButtonsEnabled(false);
            }

            // Show the confirm button
            showConfirmButton(true);
        }

        function clickCheckTurn() {
            if (!currentGameId) {
                alert('Please rejoin a game first.');
                return;
            }
            checkMyTurn(currentGameId);
        }
        
        // ── Bottom row buttons ────────────────────────────────────────────
        // Helper function to send a driving maneuver to the server
        async function sendManeuver(maneuverType) {
            if (!navState.gameId) {
                alert("You must be in an active game to move your vehicle!");
                return;
            }

            try {
                const response = await fetch('/api/game/maneuver', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        game_id: navState.gameId,
                        username: currentUser,
                        maneuver: maneuverType
                    })
                });

                if (response.ok) {
                    const result = await response.json();
                    console.log(`Maneuver ${maneuverType} accepted:`, result);
                    // Instantly force a reload of the game file to update your canvas view
                    showCurrentGameFile(true);
                } else {
                    const err = await response.json();
                    alert(`Maneuver rejected: ${err.error}`);
                }
            } catch (err) {
                console.error("Network error during maneuver execution:", err);
            }
        }

        // ── Driving Deck Button Hooks ─────────────────────────────────────────
        // These are now correctly wired into the preview pipeline tracker.
        function clickD6L() { selectDrivingVector('D6L'); }
        function clickD5L() { selectDrivingVector('D5L'); }
        function clickD4L() { selectDrivingVector('D4L'); }
        function clickD3L() { selectDrivingVector('D3L'); }
        function clickD2L() { selectDrivingVector('D2L'); }
        function clickD1L() { selectDrivingVector('D1L'); }
        function clickSTR() { selectDrivingVector('STR'); } // ← Fixed to trigger preview path!
        function clickD1R() { selectDrivingVector('D1R'); }
        function clickD2R() { selectDrivingVector('D2R'); }
        function clickD3R() { selectDrivingVector('D3R'); }
        function clickD4R() { selectDrivingVector('D4R'); }
        function clickD5R() { selectDrivingVector('D5R'); }
        function clickD6R() { selectDrivingVector('D6R'); }

        // ── Firing Action Button Hook ─────────────────────────────────────────
        async function clickFire() {
            openFiringActionDialog();
        }

        // Runtime Phase Tracking Engine States
        let activePreviewManeuver = null; 
        let currentPhaseType = "M"; // Defaults to 'M' (Movement) or 'C' (Combat)
        
        function updateButtonAvailability(phaseIndicator) {
            const maneuverButtons = document.querySelectorAll('.bottom-row .app-btn:not(#ID_CONFIRM):not(#ID_FIRE)');
            const fireActionButton = document.getElementById('ID_FIRE');
        
            if (phaseIndicator === 'Combat') {
                // DISABLE driving buttons during combat
                maneuverButtons.forEach(btn => {
                    btn.disabled = true;
                    btn.style.opacity = '0.4';
                    btn.style.pointerEvents = 'none';
                });
                if (fireActionButton) {
                    fireActionButton.disabled = false;
                    fireActionButton.style.opacity = '1.0';
                    fireActionButton.style.pointerEvents = 'auto';
                }
            } else {
                // ENABLE driving buttons during movement
                maneuverButtons.forEach(btn => {
                    btn.disabled = false;
                    btn.style.opacity = '1.0';
                    btn.style.pointerEvents = 'auto';
                });
                if (fireActionButton) {
                    fireActionButton.disabled = true;
                    fireActionButton.style.opacity = '0.4';
                    fireActionButton.style.pointerEvents = 'none';
                }
            }
        }

        function clickManeuver(maneuverCode, buttonElement) {
            // Check if the clicked button is already active
            if (activePreviewManeuver === maneuverCode) {
                // Deselect current choice: toggle off pressed look and clear the ghost image
                buttonElement.classList.remove('pressed');
                activePreviewManeuver = null;
                removeGhostVehicleOverlay();
                console.log("Cleared active preview layout");
                return;
            }
            
            // Clear out any previously active selection styles on the movement deck
            document.querySelectorAll('.maneuver-btn').forEach(btn => btn.classList.remove('pressed'));
            
            // Animate clicked option into a "pushed" state
            buttonElement.classList.add('pressed');
            activePreviewManeuver = maneuverCode;
            
            // Request math coordinates for the ghost layout and render it onto your canvas
            requestGhostVehicleOverlay(maneuverCode);
        }
        
        function requestGhostVehicleOverlay(maneuverCode) {
            console.log(`Calculating shadow coordinate footprint for: ${maneuverCode}`);
            
            // 1. Fetch current coordinates from active mapState data frame
            // 2. Project vector transformations locally or hit a fast backend math route
            // 3. Render a semi-transparent car image layer onto the canvas context
            
            // (We will hook this draw step into your drawMap() canvas engine loop)
            drawMap(); 
        }
        
        function removeGhostVehicleOverlay() {
            // Clear shadow positioning reference trackers and refresh the clean canvas view
            drawMap(); 
        }
        
        // ── Master Confirm Event Router ───────────────────────────────────────
        // Global execution lock to absolute kill concurrent event bubbling
        let isConfirmProcessing = false;

        async function clickConfirm(event) {
            // 1. If an event object passed through, kill duplication and stop event bubbling
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            // 2. Gate condition: If a message is already in flight, drop this execution instantly
            if (isConfirmProcessing) {
                console.warn("Blocked duplicate concurrent frontend click confirm event bubble.");
                return;
            }

            const confirmBtn = document.getElementById('ID_CONFIRM');
    
            // 3. Set the state lock and immediately disable the UI button
            isConfirmProcessing = true;
            if (confirmBtn) {
                confirmBtn.disabled = true;
                confirmBtn.style.opacity = '0.4';
                confirmBtn.innerText = 'Processing...';
            }
    
            // Safely extract the game tracking properties
            const activeGameId = (typeof navState !== 'undefined' && navState.gameId) ? navState.gameId : '';
            const activeFile = (typeof currentFilename !== 'undefined') ? currentFilename : '';
            const activeManeuver = (typeof chosenManeuver !== 'undefined' && chosenManeuver) ? chosenManeuver : 'STR';
    
            const payload = {
                game_id: activeGameId,
                filename: activeFile,
                maneuver: activeManeuver
            };
    
            try {
                console.log("Sending EXACTLY ONE move confirmation network packet:", payload);
        
                const response = await fetch('/api/game/confirm_move', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
        
                if (response.ok) {
                    const data = await response.json();
                    console.log("Move confirmed cleanly on server:", data);
            
                    // Clean up the local selection variable for the next movement block step
                    if (typeof chosenManeuver !== 'undefined') {
                        chosenManeuver = '';
                    }
            
                    // Refresh map canvas layouts programmatically
                    if (typeof loadGameFileList === 'function') {
                        loadGameFileList(activeGameId);
                    } else if (typeof showCurrentGameFile === 'function') {
                        showCurrentGameFile();
                    }
                } else {
                    const errData = await response.json().catch(() => ({}));
                console.error("Server rejected move confirmation registration request:", errData.error || response.statusText);
                }
            } catch (err) {
                console.error("Network interface pipeline transmission error:", err);
            } finally {
                // 4. Reset the state lock and restore the button safely after everything renders
                isConfirmProcessing = false;
                if (confirmBtn) {
                    confirmBtn.disabled = false;
                    confirmBtn.style.opacity = '1.0';
                    confirmBtn.innerText = 'Confirm';
                }
            }
        }

        
        // ── Master Driving Selection Pipeline ─────────────────────────────────
        async function selectDrivingVector(maneuverCode) {
            if (!navState.gameId) return;
    
            // Set the tracking state variable
            activePreviewManeuver = maneuverCode;
    
            // Clear all past highlights using your true styling class (.app-btn)
            document.querySelectorAll('.bottom-row .app-btn').forEach(btn => btn.classList.remove('pressed'));
    
            // Dynamically highlight the active button by targeting your uppercase HTML IDs (e.g., ID_STR)
            const btnElement = document.getElementById(`ID_${maneuverCode.toUpperCase()}`);
            if (btnElement) {
                btnElement.classList.add('pressed');
            }

            // Fire vector logic immediately up to GameEngine to add ProposedCarPosition to the file!
            await sendManeuver(maneuverCode);
        }

        // JavaScript Engine Code for client_screen.html

        async function openCombatActionDialog(presetTargetOwner = null, clientX = null, clientY = null) {
            const dialog = document.getElementById('combat-action-dialog');
            if (!dialog) return;

            try {
                // Fetch current match context state matrices from your Flask route
                const response = await fetch(`/api/game_state/${navState.gameId}`);
                const data = await response.json();
                if (!data.success) return;

                // BUGFIX: was document.getElementById('current-username').innerText.trim(),
                // but no element with that id exists in this page -- use the
                // global `currentUser` the rest of the app already relies on.
                const myCar = data.cars.find(c => c.owner === currentUser);

                if (!myCar) {
                    alert("Error: Active vehicle telemetry mapping missing for your profile.");
                    return;
                }

                // Establish crew quotas and track spent operational firing status counters
                const totalCrew = parseInt(myCar['self.var_driver_gunner_qty'] || 1) + parseInt(myCar['self.var_passenger_qty'] || 0);
                const spentActions = parseInt(myCar['turn_crew_actions_fired_count'] || 0);
                const actionsRemaining = Math.max(0, totalCrew - spentActions);

                document.getElementById('lbl-total-crew').innerText = totalCrew;
                document.getElementById('lbl-crew-remaining').innerText = actionsRemaining;

                if (actionsRemaining <= 0) {
                    alert("Tactical Limitation: All operational crew members have exhausted their firing actions this turn.");
                    return;
                }

                // 2. Populate Available Weapon Systems Dropdown
                const weaponSelect = document.getElementById('sel-combat-weapon');
                weaponSelect.innerHTML = "";
        
                // Scan standard item slots 1 to 10 matching your flat-file json schemas
                let weaponCount = 0;
                for (let i = 1; i <= 10; i++) {
                    const wName = myCar[`self.selected_sub_weapon_${i}_canvas`];
                    if (wName && wName !== 'None') {
                        const wFacing = myCar[`self.weapon_facing_${i}`] || 'Front';
                        const opt = document.createElement('option');
                        opt.value = i; // Save weapon index identifier
                        opt.textContent = `${wName} (${wFacing} Mount)`;
                        weaponSelect.appendChild(opt);
                        weaponCount++;
                    }
                }

                // 3. Populate Opponent / Targets Dropdown
                const targetSelect = document.getElementById('sel-combat-target');
                targetSelect.innerHTML = "";
        
                data.cars.forEach(car => {
                    if (car.owner !== currentUser) {
                        const opt = document.createElement('option');
                        opt.value = car.owner;
                        opt.textContent = `${car.owner} (${car.car_image_name || 'Vehicle'})`;
                        targetSelect.appendChild(opt);
                    }
                });

                // NEW: pre-select whichever car was right-clicked, if any.
                if (presetTargetOwner) {
                    targetSelect.value = presetTargetOwner;
                }

                // Toggle trigger access based on utility checks
                document.getElementById('btn-fire-weapon').disabled = (weaponCount === 0 || targetSelect.children.length === 0);

                // NEW: position near the right-click point when we have
                // coordinates; otherwise fall back to the dialog's default
                // centered position.
                if (clientX !== null && clientY !== null) {
                    positionDialogNear(dialog, clientX, clientY);
                } else {
                    dialog.style.position = '';
                    dialog.style.left = '';
                    dialog.style.top = '';
                    dialog.style.margin = '';
                }

                dialog.showModal();
                updateLiveToHitOdds();

            } catch (err) {
                console.error("Failed executing combat dialogue initializer:", err);
            }
        }

        async function updateLiveToHitOdds() {
            // Queries our backend metrics endpoint to pre-calculate odds values
            const weaponIdx = document.getElementById('sel-combat-weapon').value;
            const targetOwner = document.getElementById('sel-combat-target').value;
    
            if (!weaponIdx || !targetOwner) return;

            const payload = { game_id: navState.gameId, weapon_index: weaponIdx, target_owner: targetOwner };
    
            const response = await fetch('/api/calculate_live_to_hit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
    
            const resData = await response.json();
            const lblOdds = document.getElementById('lbl-live-to-hit');
            const lblNotes = document.getElementById('lbl-combat-notes');

            if (resData.possible) {
                lblOdds.innerText = `${resData.needed_roll}+`;
                lblOdds.style.color = '#00ff00';
                lblNotes.innerText = `Modified Target on 2D6. Distance: ${resData.distance_inches}" (${resData.arc_facing} Arc).`;
            } else {
                lblOdds.innerText = "IMPOSSIBLE";
                lblOdds.style.color = '#ff3333';
                lblNotes.innerText = resData.reason || "Target out of valid firing parameters.";
            }
        }

        function closeCombatDialog() {
            document.getElementById('combat-action-dialog').close();
        }

        // NOTE: #combat-action-dialog doesn't currently have a crew-member
        // selector (unlike #firingActionModal, which does). Since gunner
        // skill isn't wired into the to-hit math yet, this auto-picks the
        // first available crew member via the same
        // /api/game/get_firing_dialog_data endpoint your other modal
        // already uses. Swap this for a real selector once crew/gunner
        // skill starts mattering.
        async function commitFireActionAttack() {
            const weaponIdx = document.getElementById('sel-combat-weapon').value;
            const targetOwner = document.getElementById('sel-combat-target').value;
            if (!weaponIdx || !targetOwner) return;

            const fireBtn = document.getElementById('btn-fire-weapon');
            fireBtn.disabled = true;
            fireBtn.textContent = 'Firing...';

            try {
                const dialogDataRes = await fetch('/api/game/get_firing_dialog_data', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ game_id: navState.gameId }),
                });
                const dialogData = await dialogDataRes.json();
                const crewMember = (dialogData.crew || []).find(c => c.available);
                if (!crewMember) {
                    document.getElementById('lbl-combat-notes').textContent =
                        'No available crew member to fire this weapon.';
                    return;
                }

                const response = await fetch('/api/game/confirm_firing_action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        game_id: navState.gameId,
                        crew_title: crewMember.title,
                        weapon_id: weaponIdx,
                        target_owner: targetOwner,
                    }),
                });

                if (response.ok) {
                    closeCombatDialog();
                    showCurrentGameFile(true);
                } else {
                    const err = await response.json();
                    document.getElementById('lbl-combat-notes').textContent =
                        err.error || 'Firing action rejected.';
                }
            } catch (err) {
                console.error('Error committing fire action:', err);
                document.getElementById('lbl-combat-notes').textContent = 'A network error occurred.';
            } finally {
                fireBtn.disabled = false;
                fireBtn.textContent = 'ENGAGE TARGET';
            }
        }
        
        // ── Firing Action Dialog ──────────────────────────────────────────
        let firingDialogData = null;   // last-fetched crew/weapons/targets
        
        async function openFiringActionDialog() {
            const modal = document.querySelector('#firingActionModal .modal');
            modal.style.position = '';
            modal.style.left = '';
            modal.style.top = '';
            modal.style.margin = '';

            if (!navState.gameId) {
                alert("No active game selected!");
                return;
            }
        
            document.getElementById('firingActionError').style.display = 'none';
            document.getElementById('firingCrewGroup').innerHTML   = '<label>Loading...</label>';
            document.getElementById('firingWeaponGroup').innerHTML = '<label>Loading...</label>';
            document.getElementById('firingTargetGroup').innerHTML = '<label>Loading...</label>';
            document.getElementById('firingActionModal').classList.add('active');
        
            try {
                const response = await fetch('/api/game/get_firing_dialog_data', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ game_id: navState.gameId })
                });
        
                if (!response.ok) {
                    const err = await response.json();
                    showFiringActionError(err.error || 'Failed to load firing action data.');
                    return;
                }
        
                firingDialogData = await response.json();
                renderFiringDialog(firingDialogData);
        
            } catch (err) {
                console.error('Error loading firing dialog data:', err);
                showFiringActionError('A network error occurred while loading firing action data.');
            }
        }
        
        function renderFiringDialog(data) {
            // ── Crew radio group ──
            const crewGroup = document.getElementById('firingCrewGroup');
            if (!data.crew || data.crew.length === 0) {
                crewGroup.innerHTML = '<label>No crew members available.</label>';
            } else {
                crewGroup.innerHTML = data.crew.map((c, idx) => `
                    <label>
                        <input type="radio" name="firingCrew" value="${c.title}" ${c.available ? '' : 'disabled'}>
                        <span>${c.title}${c.available ? '' : ' (already fired this turn)'}</span>
                    </label>
                `).join('');
            }
        
            // ── Weapon/accessory radio group ──
            const weaponGroup = document.getElementById('firingWeaponGroup');
            if (!data.weapons || data.weapons.length === 0) {
                weaponGroup.innerHTML = '<label>This vehicle has no firing actions available.</label>';
            } else {
                weaponGroup.innerHTML = data.weapons.map((w) => `
                    <label>
                        <input type="radio" name="firingWeapon" value="${w.id}" ${w.available ? '' : 'disabled'}>
                        <span>${w.label}${w.available ? '' : ' (already used this turn)'}</span>
                    </label>
                `).join('');
            }
        
            // ── Target radio group (optional — includes a "No Target" option) ──
            const targetGroup = document.getElementById('firingTargetGroup');
            let targetHtml = `
                <label>
                    <input type="radio" name="firingTarget" value="" checked>
                    <span>No target</span>
                </label>
            `;
            if (data.targets && data.targets.length > 0) {
                targetHtml += data.targets.map((t) => `
                    <label>
                        <input type="radio" name="firingTarget" value="${t.owner}">
                        <span>${t.owner}${t.car_image_name ? ' (' + t.car_image_name + ')' : ''}</span>
                    </label>
                `).join('');
            }
            targetGroup.innerHTML = targetHtml;
        }
        
        function showFiringActionError(message) {
            const errBox = document.getElementById('firingActionError');
            errBox.textContent = message;
            errBox.style.display = 'block';
        }
        
        async function confirmFiringActionDialog() {
            const crewInput   = document.querySelector('input[name="firingCrew"]:checked');
            const weaponInput = document.querySelector('input[name="firingWeapon"]:checked');
            const targetInput = document.querySelector('input[name="firingTarget"]:checked');
        
            if (!crewInput) {
                showFiringActionError('Please select a crew member.');
                return;
            }
            if (!weaponInput) {
                showFiringActionError('Please select a weapon or accessory.');
                return;
            }
        
            const payload = {
                game_id: navState.gameId,
                crew_title: crewInput.value,
                weapon_id: weaponInput.value
            };
            if (targetInput && targetInput.value) {
                payload.target_owner = targetInput.value;
            }
        
            const confirmBtn = document.getElementById('firingActionConfirmBtn');
            confirmBtn.disabled = true;
            confirmBtn.textContent = 'Processing...';
        
            try {
                const response = await fetch('/api/game/confirm_firing_action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
        
                if (response.ok) {
                    const result = await response.json();
                    closeFiringActionDialog();
                    showCurrentGameFile(true);
                } else {
                    const err = await response.json();
                    showFiringActionError(err.error || 'Firing action rejected.');
                    // Refresh the dialog contents in case something changed server-side
                    openFiringActionDialog();
                }
            } catch (err) {
                console.error('Error confirming firing action:', err);
                showFiringActionError('A network error occurred. Please try again.');
            } finally {
                confirmBtn.disabled = false;
                confirmBtn.textContent = 'Confirm';
            }
        }
        
        function closeFiringActionDialog() {
            document.getElementById('firingActionModal').classList.remove('active');
            firingDialogData = null;
        }
        
        document.getElementById('firingActionModal').addEventListener('click', function(e) {
            if (e.target === this) closeFiringActionDialog();
        });
        
        function makeModalDraggable(overlayId) {
            const overlay = document.getElementById(overlayId);
            const modal = overlay.querySelector('.modal');
            const handle = modal.querySelector('h2');
            let isDragging = false, offsetX = 0, offsetY = 0;
        
            handle.addEventListener('mousedown', (e) => {
                isDragging = true;
                const rect = modal.getBoundingClientRect();
                offsetX = e.clientX - rect.left;
                offsetY = e.clientY - rect.top;
                modal.style.position = 'fixed';
                modal.style.left = rect.left + 'px';
                modal.style.top = rect.top + 'px';
                modal.style.margin = '0';
                e.preventDefault();
            });
        
            window.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                modal.style.left = (e.clientX - offsetX) + 'px';
                modal.style.top = (e.clientY - offsetY) + 'px';
            });
        
            window.addEventListener('mouseup', () => { isDragging = false; });
        }
        
        makeModalDraggable('firingActionModal');
    </script>
</body>
</html>
