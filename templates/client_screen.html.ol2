        // ── Upload Design Dialog ──────────────────────────────────────────
        let selectedDesignFile = null;

        function clickUploadDesign() {
            selectedDesignFile = null;
            document.getElementById('uploadDesignFilename').value = '';
            document.getElementById('designExistsWarning').classList.remove('active');
            document.querySelector('input[name="designPrivacy"][value="public"]').checked = true;
            resetUploadDesignButtons();
            document.getElementById('uploadDesignModal').classList.add('active');
        }

        function closeUploadDesignDialog() {
            document.getElementById('uploadDesignModal').classList.remove('active');
            selectedDesignFile = null;
        }

        function resetUploadDesignButtons() {
            document.getElementById('uploadDesignButtons').innerHTML = `
                <button class="btn-cancel"  onclick="closeUploadDesignDialog()">Cancel</button>
                <button class="btn-confirm" onclick="confirmUploadDesign(false)">Upload</button>`;
        }

        function showOverwriteButtons() {
            document.getElementById('uploadDesignButtons').innerHTML = `
                <button class="btn-cancel"  onclick="closeUploadDesignDialog()">Cancel</button>
                <button class="btn-warning" onclick="confirmUploadDesign(true)">Overwrite</button>`;
        }

        function browseDesignFile() {
            const fi = document.createElement('input');
            fi.type = 'file'; fi.accept = '.txt'; fi.style.display = 'none';
            document.body.appendChild(fi);
            fi.addEventListener('change', (e) => {
                const file = e.target.files[0];
                document.body.removeChild(fi);
                if (!file) return;
                selectedDesignFile = file;
                document.getElementById('uploadDesignFilename').value = file.name;
                document.getElementById('designExistsWarning').classList.remove('active');
                resetUploadDesignButtons();
            }, { once: true });
            fi.click();
        }

        async function confirmUploadDesign(overwrite = false) {
            if (!selectedDesignFile) { alert('Please select a design file.'); return; }
            const isPrivate = document.querySelector('input[name="designPrivacy"]:checked').value === 'private';
            const fd = new FormData();
            fd.append('file', selectedDesignFile);
            fd.append('is_private', isPrivate.toString());
            fd.append('overwrite',  overwrite.toString());
            try {
                const r = await fetch('/upload_designs', { method: 'POST', body: fd });
                if (r.status === 409) {
                    const data = await r.json();
                    document.getElementById('designExistsMessage').textContent =
                        `"${data.filename}" already exists. Do you want to overwrite it?`;
                    document.getElementById('designExistsWarning').classList.add('active');
                    showOverwriteButtons(); return;
                }
                if (r.ok) {
                    const result = await r.json();
                    closeUploadDesignDialog();
                    alert(`Design "${result.filename}" uploaded successfully!`);
                } else {
                    alert(`Upload failed: ${await r.text()}`);
                }
            } catch (err) { alert('A network error occurred. Please try again.'); }
        }

        document.getElementById('uploadDesignModal').addEventListener('click', function(e) {
            if (e.target === this) closeUploadDesignDialog();
        });

